<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageLS4"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:src="@drawable/list"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtUserLs2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="84dp"
        android:text="Tên"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/imageLS4"
        app:layout_constraintStart_toStartOf="@+id/imageLS4"
        app:layout_constraintTop_toTopOf="@+id/imageLS4"
        app:layout_constraintVertical_bias="0.491" />

    <TextView
        android:id="@+id/txtPointLs2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="92dp"
        android:text="Điểm"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/imageLS4"
        app:layout_constraintEnd_toEndOf="@+id/imageLS4"
        app:layout_constraintTop_toTopOf="@+id/imageLS4"
        app:layout_constraintVertical_bias="0.491" />

    <ListView
        android:id="@+id/lstUser"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/imageLS4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>