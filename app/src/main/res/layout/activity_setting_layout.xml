<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1452B3"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    tools:context=".settingLayout">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="RACING STREET"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="CÀI ĐẶT"
        android:textColor="#CBD5E1"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btnChooseCar"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#FB4247"
        android:text="CHỌN KIỂU XE"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnDifficulty"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FB4247"
        android:text="ĐỘ KHÓ"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSound"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FB4247"
        android:text="ÂM THANH"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnChangePass"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FB4247"
        android:text="ĐỔI MẬT KHẨU"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#1E293B"
        android:text="QUAY LẠI"
        android:textColor="#CBD5E1"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>